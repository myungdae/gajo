# Docker Compose reads <repository-root>/.env for interpolation. Do not put
# real values in this example or commit the operational .env file.

# Required. Generate at least 32 unpredictable bytes, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_HASH_SECRET=

# The current deployment has one API container. A future shared adapter must
# implement atomic increment and TTL semantics before changing this value.
RATE_LIMIT_STORE_MODE=memory

# Exact proxy IPs and/or explicit Docker network CIDRs, comma-separated.
# Empty is fail-closed (no trusted proxy). Rejects 0.0.0.0/0 and ::/0.
# Determine the real Docker network CIDR at deployment time; do not copy this
# documentation as an operational value.
TRUSTED_PROXY_ADDRESSES=

# Regional Manager read-only report credentials. Required JSON array; tokens
# must be independently generated secrets and are mapped to regionId server-side.
# Example shape only: [{"regionId":"hapcheon","token":"<secret>"}]
REGIONAL_REPORT_CREDENTIALS_JSON=

# Small dimension cells are suppressed before leaving the server. Default: 5.
REGIONAL_REPORT_MIN_CELL_SIZE=5

# Comma-separated region IDs authorized for region-manager writes.
# Empty is fail-closed for region-scoped write operations.
ADMIN_REGION_IDS=

# Public Kakao JavaScript app key for the client Share SDK (not a REST/admin secret).
# Register exkovia.com as a JavaScript SDK and product-link domain before release.
VITE_KAKAO_JAVASCRIPT_KEY=
