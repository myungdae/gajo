                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.amazonaws.com/travel/sunchunman.png</기록물페이지>
                        <관광명소_테마여행 rdf:resource="http://sight.eventpool.kr/resource/순천만습지_테마여행"/>
                        <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >순천만은 전라남도 순천시에 위치한 자연생태공원으로, 세계 5대 연안습지 중 하나로 꼽힙니다.&#xD;
&#xD;
광활한 갈대밭과 아름다운 일몰이 유명하며, 철새 도래지로서 다양한 조류를 관찰할 수 있습니다. 특히 순천만 국가정원과 연계된 여행 코스는 자연과 인간의 조화를 느낄 좋은 기회입니다.</dc:description>
                        <자연물_추천활동>
                          <추천활동 rdf:about="http://sight.eventpool.kr/resource/철새_관찰">
                            <추천활동_자연물 rdf:resource="http://sight.eventpool.kr/resource/우포늪"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >철새 관찰</rdfs:label>
                            <추천활동_자연물 rdf:resource="http://sight.eventpool.kr/resource/순천만"/>
                          </추천활동>
                        </자연물_추천활동>
                        <관광명소_관광명소종류>
                          <관광명소종류 rdf:about="http://sight.eventpool.kr/resource/연안습지">
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >연안습지</rdfs:label>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/순천만"/>
                          </관광명소종류>
                        </관광명소_관광명소종류>
                      </관광명소>
                    </자연물종류_자연물>
                  </자연물종류>
                </자연물_자연물종류>
                <자연물_추천활동>
                  <추천활동 rdf:about="http://sight.eventpool.kr/resource/자연_탐방로_걷기">
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >자연 탐방로 걷기</rdfs:label>
                    <추천활동_자연물 rdf:resource="http://sight.eventpool.kr/resource/제비원_습지"/>
                  </추천활동>
                </자연물_추천활동>
                <자연물_지역 rdf:resource="http://sight.eventpool.kr/resource/인제군"/>
                <자연물_테마여행 rdf:resource="http://sight.eventpool.kr/resource/늪지대답사"/>
                <자연물_추천활동 rdf:resource="http://sight.eventpool.kr/resource/생태_투어"/>
                <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >대암산 용늪은 고산지대에 위치한 한국 유일의 고산 습지로, 생태적 중요성이 매우 큽니다. 용늪은 다양한 희귀 식물과 습지 생물들이 서식하고 있으며, 자연 상태가 잘 보존된 생태 탐방지로 알려져 있습니다. 이곳은 특히 여름철 탐방이 인기가 많습니다.</dc:description>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >제비원 습지</rdfs:label>
                <자연물_지역 rdf:resource="http://sight.eventpool.kr/resource/양평군"/>
                <자연물_추천활동>
                  <추천활동 rdf:about="http://sight.eventpool.kr/resource/습지_복원_프로젝트_참여">
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >습지 복원 프로젝트 참여</rdfs:label>
                    <추천활동_자연물 rdf:resource="http://sight.eventpool.kr/resource/제비원_습지"/>
                  </추천활동>
                </자연물_추천활동>
              </자연물>
            </추천활동_자연물>
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >생태 투어</rdfs:label>
            <추천활동_자연물 rdf:resource="http://sight.eventpool.kr/resource/우포늪"/>
          </추천활동>
        </자연물_추천활동>
        <자연물_추천활동>
          <추천활동 rdf:about="http://sight.eventpool.kr/resource/자전거_탐방">
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >자전거 탐방</rdfs:label>
            <추천활동_자연물 rdf:resource="http://sight.eventpool.kr/resource/우포늪"/>
          </추천활동>
        </자연물_추천활동>
        <자연물_자연물종류 rdf:resource="http://sight.eventpool.kr/resource/습지"/>
        <자연물_추천활동 rdf:resource="http://sight.eventpool.kr/resource/철새_관찰"/>
        <자연물_테마여행 rdf:resource="http://sight.eventpool.kr/resource/늪지대답사"/>
        <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >우포늪은 한국 최대의 내륙 습지로, 생태적으로 매우 중요한 지역입니다. 약 1억 4천만 년 전에 형성된 이곳은 다양한 동식물의 서식지로, 특히 철새들의 이동 경로에서 중요한 역할을 합니다. 우포늪에서는 자연 그대로의 습지 생태계를 관찰할 수 있으며, 늪을 따라 조성된 탐방로를 걸으며 조류 관찰, 식물 탐방 등을 즐길 수 있습니다.</dc:description>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >우포늪</rdfs:label>
        <자연물_지역 rdf:resource="http://sight.eventpool.kr/resource/창녕군"/>
      </자연물>
    </지역_자연물>                                                 </경상남도>
                                                            </유물유적_지역>
                                                          </유물유적>
                                                        </시대_유물유적>
                                                        <시대_유물유적 rdf:resource="http://sight.eventpool.kr/resource/신길동_선사유적지"/>
                                                        <시대_유물유적>
                                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/울주_대곡리_반구대_암각화">
                                                            <주소
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >울산광역시 울주군 언양읍</주소>
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >울주 대곡리 반구대 암각화(蔚州 大谷里 盤龜臺 岩刻畵,?영어:?Petroglyphs of Bangudae Terrace in Daegok-ri, Ulju)는?울산광역시?울주군?언양읍에 위치한?암각화이다. 세계에서 가장 오래된?고래사냥?암각화로,?태화강?상류의 지류 하천인?대곡천의 중류부?경상 누층군?대구층?절벽에 위치하고 있다. 대한민국의 문화재로?국보 제285호로 지정되어있으며,?대한민국 문화재청이 선정하는 유네스코?세계유산?후보목록인 '우선등재목록'에 '대곡천 암각화군'으로 묶여 올라있다. 그러나 지속적인 침수와 노출의 반복으로 풍화가 가속되어 사라져가고 있다. 관련 단체들은 보존 방안을 두고 실험 실패와 갈등을 지속하고 있어, 보존을 위해 행해지는 것은 없는 상황이다.</dc:description>
                                                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/거석기념물"/>
                                                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                                                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/신석기"/>
                                                            <rdfs:label
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >울주 대곡리 반구대 암각화</rdfs:label>
                                                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/울주군"/>
                                                          </유물유적>
                                                        </시대_유물유적>
                                                        <시대_유물유적>
                                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/통영_연대도_패총">
                                                            <주소
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >경상남도 통영시 산양읍</주소>
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >이 패총은 섬의 동북쪽을 따라 ‘U’자형으로 펼쳐진 모습이며, 북쪽은 바닷가로 비스듬히 이어지고 동쪽은 가파른 언덕을 이룬다. 지형의 모습으로 보아 시대에 따라 바다의 높이가 달랐음을 알 수 있다. 패총은 7층으로 쌓은 흔적이 구분되며 아랫부분인 4층에서 7층은 신석기시대의 문화층이다. 주로 조개·검은흙·자갈과 토기들 무덤과 사람뼈들이 나왔으며,신석기 시대 사람들의 체질과 생활상을 연구하는데 도움을 준다.</dc:description>
                                                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/주거지유적"/>
                                                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/신석기"/>
                                                            <rdfs:label
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >통영 연대도 패총</rdfs:label>
                                                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/통영시"/>
                                                          </유물유적>
                                                        </시대_유물유적>
                                                        <시대_유물유적>
                                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/서울_천축사_마애사리탑">
                                                            <주소
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >서울특별시 도봉구 도봉1동</주소>
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >천축사 마애사리탑(天竺寺 磨崖舍利塔)은?서울특별시?도봉구, 천축사에 있는?조선시대의 사리탑이다. 2016년 2월 18일?서울특별시의 문화재자료?제65호로 지정되었다</dc:description>
                                                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/유물"/>
                                                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/주거지유적"/>
                                                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/신석기"/>
                                                            <rdfs:label
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >서울 천축사 마애사리탑</rdfs:label>
                                                            <유물유적_지역>
                                                              <서울특별시 rdf:about="http://sight.eventpool.kr/resource/도봉구">
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >도봉구</rdfs:label>
    <지역_유물유적 rdf:resource="http://sight.eventpool.kr/resource/서울_천축사_마애사리탑"/>
