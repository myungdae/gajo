            <테마여행_자연물 rdf:resource="http://sight.eventpool.kr/resource/용궐산"/>
            <테마여행_지역 rdf:resource="http://sight.eventpool.kr/resource/순창군"/>
          </테마여행>
        </자연물_테마여행>
