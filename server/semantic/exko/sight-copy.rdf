                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >천일홍</rdfs:label>
                                                        <주변동식물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/나리공원"/>
                                                      </주변동식물>
                                                    </관광명소_주변동식물>
