                                    <주변동식물_관광명소>
                                      <관광명소 rdf:about="http://sight.eventpool.kr/resource/금호꽃섬">
                                        <관광명소_주변동식물>
                                          <주변동식물 rdf:about="http://sight.eventpool.kr/resource/청보리">
                                            <rdfs:label rdf:datatype=
