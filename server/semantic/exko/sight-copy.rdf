    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >알파인코스터</rdfs:label>
    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/만천하_스카이워크"/>
                                                              </관광명소종류>
