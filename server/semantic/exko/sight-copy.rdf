                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/한천자연휴양림"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/연인산_명품_계곡길"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/금성산_술래길"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/상소동_산림욕장"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/함양_상림숲"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/해파랑길"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/덕고개_당숲"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/아침가리_숲길"/>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/백제부흥군길-3코스"/>
                            <관광명소종류_관광명소>
                              <관광명소 rdf:about="http://sight.eventpool.kr/resource/인제_자작나무숲">
                                <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/숲길"/>
                                <관광명소_주변동식물>
                                  <주변동식물 rdf:about="http://sight.eventpool.kr/resource/자작나무">
                                    <주변동식물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/인제_자작나무숲"/>
                                    <rdfs:label rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >자작나무</rdfs:label>
                                  </주변동식물>
                                </관광명소_주변동식물>
                                <dc:description rdf:datatype=
                                "http://www.w3.org/2001/XMLSchema#string"
                                >인제 자작나무숲은 강원도 인제군에 위치한 아름다운 자연 관광지로, 자작나무가 군락을 이루고 있는 숲입니다. 이 숲은 맑은 공기와 푸른 자연 속에서 힐링을 원하는 방문객들에게 인기 있는 장소로, 특히 자작나무의 고운 흰색과 푸른 하늘, 울창한 숲의 경치가 어우러져 아름다운 풍경을 제공합니다.&#xD;
&#xD;
자작나무숲은 산책로가 잘 조성되어 있어 자연 속에서 여유로운 산책을 즐길 수 있으며, 이곳은 도시의 소음에서 벗어나 마음의 안정을 찾을 수 있는 명소로 유명합니다. 또한 사진 촬영지로도 인기가 높아, 자연과 함께 특별한 순간을 기록하고 싶은 이들에게 매력적인 장소로 알려져 있습니다.</dc:description>
                                <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/인제군"/>
                                <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >https://linkeddata.s3.us-east-1.amazonaws.com/travel/inje_jajak.png</그림>
                                <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >https://linkeddata.s3.us-east-1.amazonaws.com/travel/inje_jajak2.png</기록물페이지>
                                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >인제 자작나무숲</rdfs:label>
                                <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >강원특별자치도 인제군 인제읍 원대리 581</주소>
                                <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >https://linkeddata.s3.us-east-1.amazonaws.com/travel/inje_jajak3.png</기록물페이지>
                                <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >37.994678, 128.198079</geo:lat_long>
                                <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >https://linkeddata.s3.us-east-1.amazonaws.com/travel/inje_jajak.png</기록물페이지>
                              </관광명소>
                            </관광명소종류_관광명소>
                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/죽녹원"/>
                          </관광명소종류>
                        </관광명소_관광명소종류>
                        <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/계곡"/>
                        <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/achim.png</그림>
                        <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/홍천군"/>
                      </관광명소>
                    </지역_관광명소>
                    <지역_자연물>
                      <자연물 rdf:about="http://sight.eventpool.kr/resource/공작산">
                        <isMemberOf rdf:resource="http://sight.eventpool.kr/resource/대한민국_100대_명산"/>
                        <높이 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >887.4 m</높이>
                        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >공작산</rdfs:label>
                        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >孔雀山</skos:altLabel>
                        <자연물_지역 rdf:resource="http://sight.eventpool.kr/resource/홍천군"/>
                      </자연물>
                    </지역_자연물>
                    <지역_자연물 rdf:resource="http://sight.eventpool.kr/resource/가리산"/>
                    <지역_관광명소 rdf:resource="http://sight.eventpool.kr/resource/배바위_카누마을"/>
                    <지역_여행인프라>
                      <글램핑_캠핑 rdf:about="http://sight.eventpool.kr/resource/홍천어울림글램핑펜션">
                        <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/eulim.png</그림>
                        <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >37.810096, 127.906312</geo:lat_long>
                        <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >홍천 어울림 글램핑 펜션은 강원도 홍천군 서면에 위치한 자연 속 힐링 글램핑장입니다. 이곳은 숲과 강이 어우러진 청정한 환경에서 편안하게 글램핑과 펜션 숙박을 함께 즐길 수 있는 곳으로, 특히 가족과 커플 단위의 여행객들에게 인기가 많습니다.&#xD;
&#xD;
글램핑 구역에는 침대, 난방 시설, 바비큐 공간 등이 갖춰져 있으며, 펜션 스타일 숙소도 마련되어 있어 다양한 숙박 옵션을 제공합니다. 주변에는 홍천강이 흐르고 있어 여름철 물놀이나 가벼운 산책을 즐기기에 좋으며, 사계절 내내 아름다운 풍경 속에서 휴식을 취할 수 있습니다.</dc:description>
                        <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >대한민국 강원특별자치도 홍천군 화촌면 구성포리 1179</주소>
                        <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/글램핑"/>
                        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >홍천어울림글램핑펜션</rdfs:label>
                        <여행인프라_지역 rdf:resource="http://sight.eventpool.kr/resource/홍천군"/>
                      </글램핑_캠핑>
                    </지역_여행인프라>
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >홍천군</rdfs:label>
                    <지역_자연물 rdf:resource="http://sight.eventpool.kr/resource/계방산"/>
                  </강원특별자치도>
                </관광명소_지역>
                <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >https://linkeddata.s3.us-east-1.amazonaws.com/travel/canoe.png</기록물페이지>
                <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >강원도 홍천군 서면 마곡길 153</주소>
                <관광명소_자연물 rdf:resource="http://sight.eventpool.kr/resource/홍천강"/>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >배바위 카누마을</rdfs:label>
                <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >배바위 카누마을은 강원도 홍천군 마곡리 강변에 위치한 자연과 어우러진 매력적인 체험 관광지입니다. 이곳은 홍천강의 맑은 물과 장락 산맥의 수려한 경관이 어우러져, 특히 가을철 단풍철에 방문하기 좋은 곳으로 손꼽힙니다. 마을의 상징인 배바위는 강변에 우뚝 솟은 거대한 바위로, 마치 거대한 범선이 강 위에 떠 있는 듯한 모습 덕에 배바위라는 이름이 붙었습니다.&#xD;
&#xD;
배바위 카누마을의 주요 매력&#xD;
&#xD;
단풍과 카누 체험&#xD;
&#xD;
가을철에 배바위 카누마을을 찾으면 강변을 따라 물든 단풍을 감상하며 카누를 탈 수 있습니다. 홍천강 위에서 보는 단풍은 마치 물 위에 색색의 그림을 그린 듯한 풍경을 만들어주어, 강을 가로지르며 주변 자연을 감상할 수 있는 특별한 체험을 제공합니다.&#xD;
&#xD;
홍천강의 아름다움&#xD;
&#xD;
홍천강은 수질이 맑고 청정하여 카누를 타기에 안성맞춤입니다. 특히 가을의 강물 위에 비치는 단풍은 마을만의 독특한 매력으로, 평온한 분위기 속에서 낭만적인 카누 여행을 즐길 수 있습니다.&#xD;
&#xD;
배바위와 장락 산맥의 조화&#xD;
&#xD;
마을을 감싸는 장락 산맥과 강변에 서 있는 배바위가 어우러져 배바위 카누마을만의 장관을 형성합니다. 자연 그대로의 풍경 속에서, 색다른 추억을 쌓을 수 있습니다.&#xD;
&#xD;
마곡리의 전통적인 매력&#xD;
&#xD;
마곡리는 소박하고 고즈넉한 시골 마을의 매력을 지니고 있어, 바쁜 일상에서 벗어나 자연과 함께 여유로운 시간을 보낼 수 있는 장소입니다. 주변에 있는 전통 가옥과 농촌 풍경이 어우러져 더욱 따뜻한 정취를 느낄 수 있습니다.</dc:description>
                <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/체험_카누"/>
              </관광명소>
            </자연물_관광명소>
            <자연물_자연물종류 rdf:resource="http://sight.eventpool.kr/resource/강"/>
          </자연물>
        </자연물종류_자연물>
        <자연물종류_자연물 rdf:resource="http://sight.eventpool.kr/resource/황룡강"/>
        <자연물종류_자연물 rdf:resource="http://sight.eventpool.kr/resource/한탄강"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >강</rdfs:label>
        <자연물종류_자연물 rdf:resource="http://sight.eventpool.kr/resource/남강"/>
        <자연물종류_자연물 rdf:resource="http://sight.eventpool.kr/resource/태화강"/>
        <자연물종류_자연물 rdf:resource="http://sight.eventpool.kr/resource/용궐산"/>
      </자연물종류>
    </자연물_자연물종류>
    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >https://linkeddata.s3.us-east-1.amazonaws.com/jangsung_hwang.png</그림>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >황룡강</rdfs:label>
    <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >35.30271817070216, 126.77393657085827</geo:lat_long>
    <자연물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/장성_황룡강_생태공원"/>
    <자연물_지역 rdf:resource="http://sight.eventpool.kr/resource/장성군"/>
                                                              </자연물>
                                                            </관광명소_자연물>
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >장성 황룡강 생태공원은 전라남도 장성군에 위치한 생태 공원으로, 황룡강을 따라 펼쳐지는 아름다운 자연경관과 다양한 생태 자원을 경험할 수 있는 명소입니다. 이 공원은 황룡강을 중심으로 다양한 식물과 동물이 살아가는 자연 친화적인 공간으로, 생태 체험과 자연 관찰을 즐길 수 있는 장소로 잘 알려져 있습니다.&#xD;
&#xD;
추천 활동&#xD;
자연 관찰 및 사진 촬영&#xD;
&#xD;
생태공원 내에서는 다양한 식물과 동물들을 관찰하고 사진으로 담을 수 있습니다. 특히 철새 관찰이 가능하여 자연 애호가들에게 좋은 기회를 제공합니다.&#xD;
산책과 트레킹&#xD;
&#xD;
황룡강을 따라 산책로를 걸으며 평화로운 자연을 만끽하거나, 자전거 도로에서 자전거를 타며 더욱 넓은 지역을 탐험할 수 있습니다.&#xD;
생태체험 프로그램 참여&#xD;
&#xD;
방문객들은 공원에서 진행되는 생태체험 프로그램에 참여하여 자연을 더욱 깊이 이해할 수 있습니다. 이는 가족 단위 방문객들에게 특히 인기가 많습니다.</dc:description>
                                                            <그림
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/jangsung_saengtae.png</그림>
                                                            <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/생태공원"/>
                                                            <rdfs:label
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >장성 황룡강 생태공원</rdfs:label>
                                                            <주소
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >대한민국 전라남도 장성군 장성읍 기산리 57-5</주소>
                                                            <geo:lat_long
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >35.30512851881105, 126.77722555444038</geo:lat_long>
                                                            <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/장성군"/>
                                                          </관광명소>
                                                        </지역_관광명소>
                                                        <기록물페이지
                                                         rdf:datatype=
                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >https://linkeddata.s3.us-east-1.amazonaws.com/jangsung_hwang.png</기록물페이지>
                                                        <기록물페이지
                                                         rdf:datatype=
                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/jangsung_saengtae.png</기록물페이지>
                                                        <지역_관광명소 rdf:resource="http://sight.eventpool.kr/resource/장성_금곡_영화마을"/>
                                                        <지역_자연물 rdf:resource="http://sight.eventpool.kr/resource/장성호"/>
                                                        <지역_유무형문화유산>
                                                          <유무형문화유산 rdf:about="http://sight.eventpool.kr/resource/필암서원">
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >필암서원(筆巖書院)은 조선 시대 유학자 김인후(金麟厚, 1510~1560)의 학문과 덕행을 기리기 위해 설립된 서원으로, 전라남도 장성군 황룡면에 위치해 있습니다.&#xD;
이 서원은 조선 후기 호남 지역의 학문과 교육의 중심지로 기능했으며, 자연과 조화를 이루는 전통적인 서원 건축의 아름다움을 간직하고 있습니다.&#xD;
&#xD;
필암서원의 설립과 역사&#xD;
&#xD;
설립 배경&#xD;
&#xD;
필암서원은 1590년(선조 23년), 김인후의 제자들이 그의 학문과 덕행을 추모하며 설립한 서원입니다. 김인후는 성리학의 대가로, 조광조의 학통을 이어받았으며, 호남 유학의 기틀을 다진 인물입니다.&#xD;
사액 서원&#xD;
&#xD;
1662년(현종 3년), **‘필암(筆巖)’**이라는 이름의 사액을 받아 조정의 공식적인 인정을 받았습니다.&#xD;
이후 호남 지역 유생들의 교육과 제향 활동의 중심지로 발전했습니다.&#xD;
필암서원의 주요 특징&#xD;
&#xD;
김인후는 호남 학파를 형성한 학자로, 조선의 성리학 발전에 기여했습니다.&#xD;
그가 왕실의 세자를 가르치던 스승이었고, 시문과 글씨에서도 탁월한 재능을 보였던 점이 필암서원의 위상을 높였습니다.&#xD;
&#xD;
문화재로의 보존&#xD;
&#xD;
필암서원은 현재 국보 제242호로 지정되어 있으며, 조선 시대 서원의 대표적 건축물로 평가받고 있습니다.&#xD;
유네스코 세계유산 등재&#xD;
&#xD;
2019년, 필암서원은 "한국의 서원" 9곳 중 하나로 선정되어 유네스코 세계유산에 등재되었습니다.&#xD;
&#xD;
이는 필암서원이 조선 시대 성리학적 전통과 서원 건축 문화를 세계적으로 인정받았음을 보여줍니다.&#xD;
&#xD;
결론&#xD;
필암서원은 단순한 교육기관을 넘어 김인후의 학문과 사상을 기리는 문화적 상징입니다. 자연과 조화를 이루는 건축, 지역 유학의 중심지로서의 역할, 그리고 오늘날까지 이어지는 역사적 가치를 통해 조선 시대 서원의 이상을 잘 보여주는 장소로 평가받고 있습니다.</dc:description>
