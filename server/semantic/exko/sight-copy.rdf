                                                <시대_유물유적 rdf:resource="http://sight.eventpool.kr/resource/화순_고인돌_유적"/>
                                                <시대_유물유적>
                                                  <유물유적 rdf:about="http://sight.eventpool.kr/resource/경주_죽동리_청동기_일괄">
                                                    <주소 rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >경상북도 경주시 월성동</주소>
                                                    <rdfs:label
                                                     rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >경주 죽동리 청동기 일괄</rdfs:label>
                                                    <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/유물"/>
                                                    <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                                                    <dc:description
                                                     rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >경주 죽동리 청동기 일괄은 경상북도 경주시 외동읍 죽동리에서 출토된 청동기 유물들입니다. 이 유물들은 청동기 시대의 생활과 제의 문화를 잘 보여주는 중요한 자료로 평가받고 있습니다.&#xD;
&#xD;
죽동리 청동기 유물들은 일반적으로 비파형 동검, 청동 방울, 거울 등으로 구성되어 있으며, 청동기의 기술 수준과 제작 기법, 당시 사람들의 사회적·종교적 삶을 이해하는 데 중요한 단서를 제공합니다. 이러한 유물들은 한국 고대사 연구에 중요한 위치를 차지하며, 청동기 시대 사람들의 생활 양식과 문화적 특징을 보여주는 귀중한 유산입니다.&#xD;
&#xD;
죽동리 청동기 유물 일괄은 현재 대한민국의 보물로 지정되어 있으며, 경주 일대의 선사 시대 유적과 연결되어 경주가 가진 역사적 가치를 높여줍니다.</dc:description>
                                                    <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/경주시"/>
                                                  </유물유적>
