        <관광명소종류_관광명소>
          <관광명소 rdf:about="http://sight.eventpool.kr/resource/왕피길">
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >왕피길</rdfs:label>
            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >왕피길은 경북 울진에 위치한 왕피천 인근의 생태 드라이브 코스로, 자연 그대로의 모습을 간직한 아름다운 경로입니다. 총 65.9km에 이르는 이 길은 가을철에는 단풍으로 물들어 장관을 이룹니다. 왕피길은 왕피천을 따라 펼쳐진 자연 풍경을 감상할 수 있는 곳으로, 생태관광지로 지정되어 있으며, 멸종위기종인 산양을 비롯한 다양한 야생동물의 서식지로도 유명합니다. 이곳에서는 생태경관 보호를 위한 예약제 탐방 프로그램이 운영되고 있어, 자연을 보호하면서도 깊이 있는 생태 체험을 할 수 있습니다.</dc:description>
            <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/wangpi.png</그림>
            <관광명소_자연물>
              <자연물 rdf:about="http://sight.eventpool.kr/resource/왕피천">
                <자연물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/왕피길"/>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >왕피천</rdfs:label>
              </자연물>
            </관광명소_자연물>
            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >36.910142, 129.270730</geo:lat_long>
            <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/드라이브_코스"/>
            <관광명소_지역>
              <경상북도 rdf:about="http://sight.eventpool.kr/resource/울진군">
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >울진군</rdfs:label>
                <지역_관광명소 rdf:resource="http://sight.eventpool.kr/resource/왕피길"/>
              </경상북도>
            </관광명소_지역>
          </관광명소>
