                                                     rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >37.801463, 126.873551</geo:lat_long>
                                                    <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/파주시"/>
                                                  </관광명소>
                                                </지역_관광명소>
