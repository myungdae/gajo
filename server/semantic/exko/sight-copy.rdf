                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/milbridge.png</그림>
                                            <관광명소_관광명소종류>
                                              <관광명소종류 rdf:about="http://sight.eventpool.kr/resource/체험학습장">
                                                <관광명소종류_관광명소>
                                                  <관광명소 rdf:about="http://sight.eventpool.kr/resource/유천와이너리">
                                                    <그림 rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >https://linkeddata.s3.amazonaws.com/travel/winery.png</그림>
                                                    <기록물페이지 rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
