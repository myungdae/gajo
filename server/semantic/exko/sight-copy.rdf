                                    <지역_여행인프라>
                                      <카페점 rdf:about="http://sight.eventpool.kr/resource/정원산책(카페)">
                                        <여행인프라_지역 rdf:resource="http://sight.eventpool.kr/resource/무주군"/>
                                        <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/카페"/>
