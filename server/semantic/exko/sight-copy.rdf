    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/jangsung.png</기록물페이지>
    <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >35.421040, 126.807106</geo:lat_long>                     </관광명소>
