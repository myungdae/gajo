                    <맛집_숙박 rdf:resource="http://sight.eventpool.kr/resource/합천호_스마일펜션"/>
                    <맛집_지역>
                      <경상남도 rdf:about="http://sight.eventpool.kr/resource/합천군">
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/youngamsa.png</기록물페이지>
                        <지역_관광명소>
                          <관광명소 rdf:about="http://sight.eventpool.kr/resource/해인사_성보박물관">
                            <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
