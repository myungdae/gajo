    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >체험 레이바이크</rdfs:label>
    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/김해_낙동강_레일바이크"/>
                                                              </관광명소종류>
