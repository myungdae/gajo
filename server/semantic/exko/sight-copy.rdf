                            <인근관광명소>
                              <관광명소 rdf:about="http://sight.eventpool.kr/resource/해인사">
                                <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >https://linkeddata.s3.us-east-1.amazonaws.com/travel/haein.png</그림>
                                <인근관광명소>
                                  <관광명소 rdf:about="http://sight.eventpool.kr/resource/합천_가야산_소리길">
                                    <관광명소_여행인프라>
                                      <글램핑_캠핑 rdf:about="http://sight.eventpool.kr/resource/소리길_오토_갬핑장">
                                        <여행인프라_자연물>
                                          <자연물 rdf:about="http://sight.eventpool.kr/resource/가야산">
                                            <자연물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/합천_가야산_소리길"/>
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >가야산</rdfs:label>
                                            <자연물_지역>
