                        >문화재단지</rdfs:label>
                      </관광명소종류>
                    </관광명소_관광명소종류>
                    <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >37.504870, 128.100813</geo:lat_long>
                    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >횡성회다지소리문화체험관</skos:altLabel>
                  </관광명소>
                </여행인프라_관광명소>
                <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/글램핑"/>
                <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >횡성에 위치한 써니힐글램핑은 한적한 산 속에서 운치 있는 분위기와 아름다운 뷰, 맑은 공기를 누릴 수 있다는 장점을 가진 캠핑장인데요.&#xD;
&#xD;
뛰어놀기 좋은 잔디운동장과 모래놀이터, 트램펄린 등의 놀이시설이 갖춰져있어 자녀가 있는 가족들이 방문하기에 좋아 가족 힐링 숙소로 유명한 곳입니다.&#xD;
&#xD;
7평의 객실은 커플이나 4인 가족이 머무르기 좋으며, 제공된 안락의자에 앉아 탁 트인 숲 속 뷰를 마주하면 답답한 마음이 뻥 뚫리는 경험을 할 수 있습니다. 주변에는 정금향토민속관, 다지소리 문화체험관, 밀말소류지가 있으니 한번쯤 방문해보시면 좋겠습니다.</dc:description>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >횡성써니힐글램핑</rdfs:label>
                <여행인프라_지역>
                  <강원특별자치도 rdf:about="http://sight.eventpool.kr/resource/횡성군">
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >횡성군</rdfs:label>
                    <지역_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/횡성써니힐글램핑"/>
                  </강원특별자치도>
                </여행인프라_지역>
              </글램핑_캠핑>
            </인프라종류_여행인프라>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/제천_디투어스캠프클럽"/>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/포항_클램핑앤카라반"/>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/가평_세라핌_캠프"/>
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >글램핑</rdfs:label>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/홍천어울림글램핑펜션"/>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/대부도_캠핑성"/>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/산청_럭셔리글램핑"/>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/강화도_무지개글램핑"/>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/사천_비토애_글램핑"/>
            <인프라종류_여행인프라>
              <글램핑_캠핑 rdf:about="http://sight.eventpool.kr/resource/제천_모노레일글램핑">
                <여행인프라_관광명소 rdf:resource="http://sight.eventpool.kr/resource/청풍호"/>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >제천 모노레일글램핑</rdfs:label>
                <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >제천에 위치한 모노레일글램핑입니다. 이곳은 제천의 유명 관광지로 손꼽히는 청풍호 바로 앞에 위치한 글램핑 캠핑장인데요. 글램핑장의 앞에는 청풍호가, 뒤에는 모노레일이 있으며 청풍호반의 풍경을 도보로 편하게 감상할 수 있습니다.&#xD;
&#xD;
객실 타입은 카바나 글램핑과 카라반 글램핑으로 나눌 수 있으며, 카라반 글램핑의 경우 최대 6인까지 사용이 가능합니다. 객실마다 샤워부스가 따로 비치되어 있어 다른 이용자들과 겹칠 일이 없고, 바닥난방도 조절이 가능해 추운 겨울에도 안심하고 글램핑을 즐길 수 있습니다.&#xD;
&#xD;
주변에는 치유의숲과 능강계곡, 수몰역사관, 청풍호 유람선 등이 있으니 방문해보시길 추천드립니다.</dc:description>
                <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/글램핑"/>
                <여행인프라_지역 rdf:resource="http://sight.eventpool.kr/resource/제천시"/>
              </글램핑_캠핑>
            </인프라종류_여행인프라>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/강촌_버즈글램핑"/>
            <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/포천_노블글램핑"/>
          </인프라종류>
        </여행인프라_인프라종류>
