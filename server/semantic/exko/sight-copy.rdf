                                            <관광명소_주변동식물 rdf:resource="http://sight.eventpool.kr/resource/동백나무"/>
                                            <기록물페이지 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/sununsa2.png</기록물페이지>
                                          </관광명소>
