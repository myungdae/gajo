                                                    >온실</rdfs:label>
                                                    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/금강수목원"/>
                                                    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/여미지_식물원"/>
