                    <테마여행_관광명소 rdf:resource="http://sight.eventpool.kr/resource/거제_해금강"/>
                    <테마여행_지역 rdf:resource="http://sight.eventpool.kr/resource/거제시"/>
                  </테마여행>
                </관광명소_테마여행>
