                        <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/남동구"/>
                      </관광명소>
                    </여행인프라_관광명소>
                    <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/지역축제"/>
                  </축제_전시>
                </인프라종류_여행인프라>
                <인프라종류_여행인프라>
                  <축제_전시 rdf:about="http://sight.eventpool.kr/resource/마산_가고파국화축제">
                    <여행인프라_지역>
                      <경상남도 rdf:about="http://sight.eventpool.kr/resource/창원시">
                        <지역_유물유적>
                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/창원_상남동_지석묘">
                            <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >경상남도 창원시 성산구 상남동</주소>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >창원 상남지석묘(昌原 上南支石墓)는?경상남도?창원시?성산구?상남동에 있는?고인돌이다.?2000년?1월 31일?경상남도의 기념물?제224호로 지정되었다.</dc:description>
                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/거석기념물"/>
                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >창원 상남동 지석묘</rdfs:label>
                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/창원시"/>
                          </유물유적>
                        </지역_유물유적>
                        <지역_유물유적>
                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/창원_진동리_유적">
                            <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >경상남도 창원시 마산합포구 진동면</주소>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >창원 진동리 유적(昌原 鎭東里 遺蹟)은?경상남도?창원시?마산합포구?진동면에 있는 청동시대의 유적분포지이다. 2006년 8월 29일?대한민국의 사적?제472호로 지정되었다.</dc:description>
                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/거석기념물"/>
                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >창원 진동리 유적</rdfs:label>
                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/창원시"/>
                          </유물유적>
                        </지역_유물유적>
                        <지역_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/마산_가고파국화축제"/>
                        <지역_유물유적 rdf:resource="http://sight.eventpool.kr/resource/창원_다호리_고분군"/>
                        <지역_관광명소>
                          <관광명소 rdf:about="http://sight.eventpool.kr/resource/진해_내수면환경생태공원">
                            <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >경상남도 창원시 진해구 여명로25번길 55</주소>
                            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >35.164239, 128.659900</geo:lat_long>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >진해 내수면환경생태공원</rdfs:label>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >진해내수면 환경생태공원은 경남 창원시 진해구 여명로에 위치한 아름다운 생태공원으로, 투명한 저수지를 따라 산책하며 그림 같은 풍경을 즐길 수 있는 명소입니다.&#xD;
&#xD;
이 공원은 다양한 수목과 화훼가 서식하고, 습지와 조화로운 자연 환경이 조성되어 있어 생태학습과 힐링에 적합합니다. 공원 내에는 약 83,897㎥ 규모의 친환경 생태공간이 마련되어 있어, 가족 단위 방문객들에게 특히 인기가 많으며, 아이들을 위한 자연학습 체험과 문화 휴식 공간으로도 좋습니다.</dc:description>
                            <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/생태공원"/>
                            <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/naesoo.png</그림>
                            <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/창원시"/>
                          </관광명소>
                        </지역_관광명소>
                        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >창원시</rdfs:label>
                        <지역_유물유적>
                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/창원_성산_패총">
                            <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >경상남도 창원시 성산구 중앙동</주소>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >창원 성산 패총(昌原 城山 貝塚)은?경상남도?창원시?성산구?외동에 위치한?철기시대?초기의 대규모?패총이다. 1974년 11월 2일?대한민국의 사적?제240호?마산외동성산패총으로 지정되었으나, 2011년 현재의 명칭으로 변경되었다</dc:description>
                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/주거지유적"/>
                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >창원 성산 패총</rdfs:label>
                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/창원시"/>
                          </유물유적>
                        </지역_유물유적>
                        <지역_유물유적>
                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/창원_남산유적">
                            <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >경상남도 창원시 의창구 의창동</주소>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >창원 남산 유적(昌原 南山 遺跡)은?경상남도?창원시?의창구?서상동에 있는?유적이다.?1997년?12월 31일?경상남도의 기념물?제201호로 지정되었다.</dc:description>
                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/주거지유적"/>
                            <유물유적_시대>
                              <시대 rdf:about="http://sight.eventpool.kr/resource/청동기조선">
