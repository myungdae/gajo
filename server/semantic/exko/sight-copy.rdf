                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/새우타워"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >타워</rdfs:label>
                          </관광명소종류>
                        </관광명소_관광명소종류>
