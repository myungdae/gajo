                                                  <관광명소 rdf:about="http://sight.eventpool.kr/resource/산들소리_수목원">
                                                    <그림 rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/sandul.png</그림>
