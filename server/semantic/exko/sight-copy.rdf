                                          <유무형문화유산 rdf:about="http://sight.eventpool.kr/resource/창덕궁">
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >창덕궁</rdfs:label>
                                            <유무형문화재_유무형문화재종류>
                                              <유무형문화재종류 rdf:about="http://sight.eventpool.kr/resource/궁궐">
                                                <유무형문화재종류_유무형문화재 rdf:resource="http://sight.eventpool.kr/resource/창덕궁"/>
                                                <유무형문화재종류_유무형문화재>
                                                  <유무형문화유산 rdf:about="http://sight.eventpool.kr/resource/경복궁">
                                                    <dc:description
                                                     rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >경복궁은 서울의 중심에 위치한 조선시대의 대표 궁궐로, 전통 건축물과 궁궐 문화, 그리고 역사적 배경을 체험할 수 있는 중요한 관광명소입니다. 조선 왕조의 정치와 생활을 엿볼 수 있는 경복궁은 그 자체로 역사적 가치가 크며, 많은 관광객이 찾는 명소로 알려져 있습니다. 궁궐 내에서는 왕실의 의식, 생활상, 그리고 건축 예술을 경험할 수 있으며, 다양한 문화 행사와 전통 프로그램이 진행되어 방문객들에게 풍성한 체험을 제공합니다. 경복궁은 한국의 역사와 문화를 이해하는 데 중요한 장소로, 과거와 현재를 연결하는 의미 있는 공간입니다.</dc:description>
                                                    <유무형문화유산_테마여행>
                                                      <테마여행 rdf:about="http://sight.eventpool.kr/resource/고궁역사탐방">
