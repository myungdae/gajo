                              <역사적인물 rdf:about="http://sight.eventpool.kr/resource/김대건">
                                <역사적인물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/안성_미리내성지"/>
                                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
