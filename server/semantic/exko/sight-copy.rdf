                                                            <유무형문화재_유무형문화재종류 rdf:resource="http://sight.eventpool.kr/resource/민속놀이"/>
                                                            <유무형문화유산_유물유적 rdf:resource="http://sight.eventpool.kr/resource/광한루"/>
                                                            <rdfs:label
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >월궁 낙화놀이</rdfs:label>
                                                            <유무형문화유산_지역 rdf:resource="http://sight.eventpool.kr/resource/남원시"/>
                                                          </유무형문화유산>
                                                        </유물유적_유무형문화유산>
                                                        <geo:lat_long
                                                         rdf:datatype=
                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >35.403892, 127.379807</geo:lat_long>
                                                        <rdfs:label
                                                         rdf:datatype=
                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >광한루</rdfs:label>
                                                        <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/남원시"/>
                                                      </유물유적_>
                                                    </지역_유물유적>
                                                    <지역_자연물 rdf:resource="http://sight.eventpool.kr/resource/지리산"/>
                                                    <지역_유무형문화유산 rdf:resource="http://sight.eventpool.kr/resource/월궁_천둥날리기"/>
                                                    <지역_유무형문화유산 rdf:resource="http://sight.eventpool.kr/resource/월궁_낙화놀이"/>
