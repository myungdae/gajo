        >35.01492978144665, 128.41994388326628</geo:lat_long>
        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gosung_goojul2.png</기록물페이지>
