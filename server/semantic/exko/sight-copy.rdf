    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >산성</rdfs:label>
    <유무형문화재종류_유무형문화재 rdf:resource="http://sight.eventpool.kr/resource/공산성"/>
    <유무형문화재종류_유무형문화재 rdf:resource="http://sight.eventpool.kr/resource/남한산성"/>
    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/연천_호로고루"/>
