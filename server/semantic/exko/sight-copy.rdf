                                    <관광명소_주변동식물 rdf:resource="http://sight.eventpool.kr/resource/메타세쿼이아"/>
                                    <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/agape4.png</기록물페이지>
                                    <관광명소_관광명소종류>
                                      <관광명소종류 rdf:about="http://sight.eventpool.kr/resource/자연공원">
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >자연공원</rdfs:label>
                                        <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/아가페정원"/>
                                      </관광명소종류>
                                    </관광명소_관광명소종류>
                                    <geo:lat_long rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >36.019871, 126.957849</geo:lat_long>
                                    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/agape.png</그림>
                                    <rdfs:label rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >아가페정원</rdfs:label>
                                    <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/테마정원"/>
                                    <관광명소_주변동식물>
                                      <주변동식물 rdf:about="http://sight.eventpool.kr/resource/섬잣나무">
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >섬잣나무</rdfs:label>
                                        <주변동식물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/아가페정원"/>
                                      </주변동식물>
                                    </관광명소_주변동식물>
                                    <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/agape5.png</기록물페이지>
                                    <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/agape2.png</기록물페이지>
                                    <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/agape3.png</기록물페이지>
                                    <dc:description rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >아가페정원은 전북 익산시 황등면에 위치한 자연공원으로, 특히 단풍이 물든 거대한 메타세쿼이아길이 펼쳐져 있어 가을철에 방문하기에 완벽한 장소입니다. 이 정원은 전라북도 제4호 민간 정원으로 지정되었으며, 메타세쿼이아, 섬잣나무, 공작단풍 등 17종의 다양한 수목이 자생하는 아름다운 풍경을 자랑합니다.&#xD;
&#xD;
아가페정원은 1970년 故 서정수 신부가 노인복지시설 아가페정양원을 설립하며, 어르신들의 건강한 노후를 위해 자연 친화적인 정원을 조성한 데서 시작되었습니다. 그로 인해 이곳은 단순히 아름다운 자연공원일 뿐만 아니라, 사회적 가치와 의미를 담고 있는 공간으로 많은 이들에게 사랑받고 있습니다.&#xD;
&#xD;
이 정원은 다양한 나무들로 이루어진 아름다운 숲과 평화로운 분위기 속에서, 자연과 사람을 연결하는 소중한 역할을 합니다.</dc:description>
                                    <관광명소_주변동식물>
                                      <주변동식물 rdf:about="http://sight.eventpool.kr/resource/공작단풍">
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >공작단풍</rdfs:label>
                                        <주변동식물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/아가페정원"/>
                                      </주변동식물>
                                    </관광명소_주변동식물>
                                    <관광명소_지역>
                                      <전북특별자치도 rdf:about="http://sight.eventpool.kr/resource/익산시">
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >익산시</rdfs:label>
                                        <지역_유물유적>
                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/익산_영등동_유적">
                                            <주소 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >전북특별자치도 익산시 영등2동</주소>
                                            <dc:description rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >익산 영등동 유적은?전북특별자치도?익산시?영등동에 있는 청동기 시대의 유적이다. 2002년 5월 30일?익산시의 향토유적?제1호로 지정되었다.</dc:description>
                                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/주거지유적"/>
                                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >익산 영등동 유적</rdfs:label>
                                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/익산시"/>
                                          </유물유적>
                                        </지역_유물유적>
                                        <지역_관광명소 rdf:resource="http://sight.eventpool.kr/resource/아가페정원"/>
                                        <지역_유물유적>
                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/백제역사유적지구">
                                            <유물유적_시대>
                                              <시대 rdf:about="http://sight.eventpool.kr/resource/백제">
                                                <rdfs:label rdf:datatype=
                                                "http://www.w3.org/2001/XMLSchema#string"
                                                >백제</rdfs:label>
                                                <시대_유물유적>
                                                  <유물유적 rdf:about="http://sight.eventpool.kr/resource/몽촌토성">
                                                    <주소 rdf:datatype=
                                                    "http://www.w3.org/2001/XMLSchema#string"
                                                    >서울특별시 송파구 오륜동</주소>
                                                    <유물유적_관광명소>
                                                      <관광명소 rdf:about="http://sight.eventpool.kr/resource/올림픽공원">
                                                        <기록물페이지
                                                         rdf:datatype=
                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/songpa_olympic2.png</기록물페이지>
                                                        <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/공원"/>
                                                        <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/산책로"/>
                                                        <dc:description
                                                         rdf:datatype=
                                                        "http://www.w3.org/2001/XMLSchema#string"
                                                        >올림픽공원은 서울특별시 송파구 올림픽로 424에 위치한 복합 생태문화 공간으로, 자연과 역사가 조화롭게 어우러진 도심 속 명소입니다. 1988년 서울올림픽의 개최를 기념해 조성된 이곳은 스포츠, 자연, 역사, 문화재가 한데 어우러진 공간으로, 서울 시민뿐만 아니라 관광객들에게도 사랑받는 명소입니다.&#xD;
&#xD;
자연과 힐링:&#xD;
&#xD;
공원 내부는 녹음이 짙은 숲과 호수가 어우러져 도심 속에서 여유를 느낄 수 있는 자연 공간입니다.&#xD;
사계절의 변화를 가까이에서 느낄 수 있는 산책로와 조경은 산책, 조깅, 자전거 타기 등 다양한 야외활동에 적합합니다.&#xD;
88호수와 들꽃마루는 특히 사진 명소로 알려져 있습니다.&#xD;
&#xD;
역사적 가치:&#xD;
&#xD;
공원 내에는 삼국시대 백제의 몽촌토성이 자리 잡고 있어, 고대 유적지를 산책하며 역사의 숨결을 느낄 수 있습니다.&#xD;
&#xD;
몽촌토성 인근에는 몽촌역사관이 있어 고대 백제의 생활상을 엿볼 수 있습니다.&#xD;
&#xD;
문화와 예술:&#xD;
&#xD;
공원 곳곳에는 세계 각국의 조각 작품들이 전시되어 있는 조각공원이 있어 자연 속에서 예술 감상을 할 수 있습니다.&#xD;
올림픽 정신을 기리기 위한 올림픽기념관은 스포츠와 올림픽 역사에 대한 이해를 도와줍니다.</dc:description>
