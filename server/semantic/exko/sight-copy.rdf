    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/oido.png</그림>
    <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/시흥시"/>
