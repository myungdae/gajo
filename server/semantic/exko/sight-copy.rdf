                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/juksansan.png</그림>
                                            <skos:altLabel rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >赤裳山</skos:altLabel>
