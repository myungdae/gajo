                                          <관광명소종류 rdf:about="http://sight.eventpool.kr/resource/해안선">
                                            <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/행남_해안산책로"/>
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >해안선</rdfs:label>
                                          </관광명소종류>
