                    <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/천안시"/>
                  </유물유적>
                </지역_유물유적>
              </충청남도>
            </유무형문화유산_지역>
          </유무형문화유산>
        </테마여행_유무형문화유산>
        <테마여행_테마여행종류 rdf:resource="http://sight.eventpool.kr/resource/역사탐방"/>
        <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >한국의 독립운동 역사 탐방&#xD;
주요 방문지: 서대문형무소 역사관, 독립기념관, 유관순 기념관, 임시정부 청사 (상하이, 중국) 등.&#xD;
활동 내용:&#xD;
일제강점기 당시 독립운동가들이 수감된 서대문형무소를 방문해 고문실과 독립운동가들의 흔적을 직접 둘러봅니다.&#xD;
천안 독립기념관에서는 한국 독립운동의 전반적인 흐름과 역사를 한눈에 볼 수 있으며, 다양한 체험 프로그램에 참여할 수 있습니다.&#xD;
의미: 독립운동가들의 희생과 애국심을 직접 체감하며 한국 근대사의 중요한 부분을 배울 수 있습니다.</dc:description>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >독립운동 역사 탐방</rdfs:label>
        <테마여행_유무형문화유산>
          <유무형문화유산 rdf:about="http://sight.eventpool.kr/resource/서대문형무소">
            <유무형문화재_유무형문화재종류 rdf:resource="http://sight.eventpool.kr/resource/기념관"/>
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >서대문형무소</rdfs:label>
            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >37.574271,126.956071</geo:lat_long>
            <유무형문화유산_테마여행 rdf:resource="http://sight.eventpool.kr/resource/독립운동_역사_탐방"/>
            <유무형문화유산_지역>
              <서울특별시 rdf:about="http://sight.eventpool.kr/resource/서대문구">
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >서대문구</rdfs:label>
                <지역_유무형문화유산 rdf:resource="http://sight.eventpool.kr/resource/서대문형무소"/>
              </서울특별시>
            </유무형문화유산_지역>
          </유무형문화유산>
        </테마여행_유무형문화유산>
        <테마여행_유무형문화유산 rdf:resource="http://sight.eventpool.kr/resource/독립기념관"/>
      </테마여행>
    </테마여행종류_테마여행>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >역사탐방</rdfs:label>
    <테마여행종류_테마여행 rdf:resource="http://sight.eventpool.kr/resource/임진왜란_역사_탐방"/>
    <테마여행종류_테마여행>
      <테마여행 rdf:about="http://sight.eventpool.kr/resource/신라_시대_역사_탐방">
        <테마여행_유무형문화유산>
          <유무형문화유산 rdf:about="http://sight.eventpool.kr/resource/첨성대">
            <유무형문화재_유무형문화재종류>
              <유무형문화재종류 rdf:about="http://sight.eventpool.kr/resource/천문_유적지">
                <유무형문화재종류_유무형문화재 rdf:resource="http://sight.eventpool.kr/resource/첨성대"/>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >천문 유적지</rdfs:label>
              </유무형문화재종류>
            </유무형문화재_유무형문화재종류>
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >첨성대</rdfs:label>
            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >37.986794, 126.539707</geo:lat_long>
            <유무형문화유산_테마여행 rdf:resource="http://sight.eventpool.kr/resource/신라_시대_역사_탐방"/>
          </유무형문화유산>
        </테마여행_유무형문화유산>
        <테마여행_유무형문화유산>
          <유무형문화유산 rdf:about="http://sight.eventpool.kr/resource/포석정">
            <유무형문화유산_테마여행 rdf:resource="http://sight.eventpool.kr/resource/신라_시대_역사_탐방"/>
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >포석정</rdfs:label>
            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >경주는 가을이면 단풍과 신라 천년의 역사가 어우러진 특별한 매력을 선사하는 도시입니다. 그중 포석정은 통일신라시대의 별궁 유적으로, 왕이 물길에 술잔을 띄워 시를 읊던 유상곡수연 놀이가 펼쳐졌던 역사적인 장소로 잘 알려져 있습니다. 가을에는 포석정 주위에 붉은 단풍이 곱게 물들어 신라의 역사와 자연의 아름다움이 조화롭게 어우러져, 깊고 고즈넉한 가을 정취를 느끼기에 제격입니다.&#xD;
&#xD;
포석정을 방문한 후에는 유네스코 세계문화유산으로 등재된 불국사와 석굴암을 차례로 둘러보는 코스를 추천합니다. 불국사의 단풍은 고즈넉한 사찰 분위기와 어우러져 전통과 자연의 장관을 연출하며, 석굴암으로 이어지는 길에서는 한적한 가을 풍경을 온전히 만끽할 수 있습니다. 이처럼 경주는 가을 단풍과 고대의 역사가 조화를 이루어 색다른 가을 여행을 원하는 방문객들에게 특별한 감동을 선사합니다.</dc:description>
            <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/posukjung.png</기록물페이지>
            <참고 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >유상곡수연 놀이</참고>
            <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/posukjung2.png</기록물페이지>
            <유무형문화재_유무형문화재종류 rdf:resource="http://sight.eventpool.kr/resource/테마정원"/>
            <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/posukjung.png</그림>
            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >35.807088, 129.212603</geo:lat_long>
          </유무형문화유산>
        </테마여행_유무형문화유산>
        <테마여행_테마여행종류 rdf:resource="http://sight.eventpool.kr/resource/역사탐방"/>
        <테마여행_자연물>
          <자연물 rdf:about="http://sight.eventpool.kr/resource/토함산">
            <자연물_자연물종류 rdf:resource="http://sight.eventpool.kr/resource/산"/>
            <자연물_관광명소>
              <관광명소 rdf:about="http://sight.eventpool.kr/resource/불국사">
                <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >https://linkeddata.s3.us-east-1.amazonaws.com/travel/bulgook.png</기록물페이지>
                <관광명소_자연물 rdf:resource="http://sight.eventpool.kr/resource/토함산"/>
                <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/경주시"/>
                <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >https://linkeddata.s3.amazonaws.com/travel/bulguk.png</기록물페이지>
                <관광명소_부분>
                  <부분 rdf:about="http://sight.eventpool.kr/resource/다보탑">
                    <부분_관광명소 rdf:resource="http://sight.eventpool.kr/resource/불국사"/>
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >다보탑</rdfs:label>
                  </부분>
                </관광명소_부분>
                <관광명소_부분>
                  <부분 rdf:about="http://sight.eventpool.kr/resource/석가탑">
                    <부분_관광명소 rdf:resource="http://sight.eventpool.kr/resource/불국사"/>
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >석가탑</rdfs:label>
                  </부분>
                </관광명소_부분>
                <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >불국사는 경북 경주에 위치한 세계문화유산으로, 한국 불교의 대표적인 사찰 중 하나입니다. 신라 시대에 창건된 이 사찰은 뛰어난 건축미와 예술적 가치를 지니고 있으며, 불교의 교리와 철학을 잘 담고 있는 장소입니다.&#xD;
&#xD;
불국사는 특히 '석가탑'과 '다보탑'이라는 두 개의 유명한 탑으로 잘 알려져 있습니다. 이 두 탑은 불국사의 상징적 구조물로, 각각 석가모니와 다보여래를 의미하며, 고대 한국의 건축 기술과 미학을 보여줍니다. 사찰의 정원과 계곡, 그리고 주변의 아름다운 자연경관은 방문객들에게 평화로운 분위기를 제공합니다.</dc:description>
                <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/사찰"/>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >불국사</rdfs:label>
