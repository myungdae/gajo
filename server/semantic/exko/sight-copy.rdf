                                                        <종류_유물유적>
                                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/돌팡구지">
                                                            <주소
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >경기도 부천시 오정구 중동</주소>
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >돌팡구지는?경기도?부천시에 위치한 선사시대의 청동기 거석기념물이다. 납작하고 짤막한 받침돌을 양편에 세우고, 그 위에 평평한 덮개돌(또는 뚜껑돌)을 덮은 청동기시대 부족장의 무덤인 침존형(일명 남방식) 고인돌(덮개돌)로 보이는 큰 바위이다. 남북 길이가 4m, 동서가 2m로 상단 표면에 다산과 풍요를 기원하기 위한 성혈(性穴)이 있다.</dc:description>
                                                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/거석기념물"/>
                                                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                                                            <rdfs:label
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >돌팡구지</rdfs:label>
                                                            <유물유적_지역>
                                                              <경기도 rdf:about="http://sight.eventpool.kr/resource/부천시">
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >부천시</rdfs:label>
    <지역_유물유적 rdf:resource="http://sight.eventpool.kr/resource/돌팡구지"/>
                                                              </경기도>
                                                            </유물유적_지역>
                                                          </유물유적>
                                                        </종류_유물유적>
                                                        <종류_유물유적 rdf:resource="http://sight.eventpool.kr/resource/세종_국곡리_입석"/>
                                                        <종류_유물유적>
                                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/고령_장기리_암각화">
                                                            <skos:altLabel
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >高靈 場基里 岩刻</skos:altLabel>
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >고령 장기리 암각화는 경상북도 고령군 장기리에 위치한 선사시대의 암각화 유적입니다. 이 암각화는 주로 청동기 시대와 관련된 것으로, 바위에 새겨진 다양한 그림들이 발견되어 고대 사람들의 생활과 신앙, 문화에 대한 중요한 정보를 제공합니다.&#xD;
&#xD;
장기리 암각화는 주로 동물의 형태, 인물 상징 등이 그려져 있으며, 신성한 의식이나 사냥의 제의와 관련이 있을 것으로 추정됩니다. 또한, 이 유적은 당시 사람들의 사회적 관계와 종교적 상징성을 엿볼 수 있는 중요한 자료로, 그 당시 사람들의 세계관과 사고방식을 이해하는 데 중요한 역할을 합니다.&#xD;
&#xD;
고령 장기리 암각화는 고대 한국의 청동기 시대 문화와 예술을 대표하는 유산 중 하나로, 사적으로 지정되어 보호되고 있으며, 고령 지역에서 출토된 다양한 선사 시대 유물들과 함께 연구되고 있습니다.</dc:description>
                                                            <유물유적_종류>
                                                              <종류 rdf:about="http://sight.eventpool.kr/resource/암각화">
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >암각화</rdfs:label>
    <종류_유물유적 rdf:resource="http://sight.eventpool.kr/resource/고령_장기리_암각화"/>
