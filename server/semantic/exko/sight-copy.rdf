                                    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/해운대_미포"/>
                                    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/수뭇개바위"/>
                                    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/강동_몽돌해변"/>
                                    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/오륙도"/>
