          </테마여행>
        </유무형문화유산_테마여행>
        <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >35.2568051,128.4140446</geo:lat_long>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >성산산성</rdfs:label>
        <유무형문화재_유무형문화재종류 rdf:resource="http://sight.eventpool.kr/resource/산성"/>
        <유무형문화유산_지역 rdf:resource="http://sight.eventpool.kr/resource/함안군"/>
      </유무형문화유산>
