                                                            <관광명소종류_관광명소>
                                                              <관광명소 rdf:about="http://sight.eventpool.kr/resource/지산샛강생태공원">
    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gumi_jisan.png</그림>
    <관광명소_주변동식물>
      <주변동식물 rdf:about="http://sight.eventpool.kr/resource/연꽃">
        <주변동식물_관광명소>
          <관광명소 rdf:about="http://sight.eventpool.kr/resource/청산수목원">
            <관광명소_주변동식물 rdf:resource="http://sight.eventpool.kr/resource/연꽃"/>
