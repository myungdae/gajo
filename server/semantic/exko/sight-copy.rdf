                                          </대구광역시>
                                        </유무형문화유산_지역>
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >도동서원</rdfs:label>
                                        <기록물페이지 rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/dalsung_dodong2.png</기록물페이지>
                                        <기록물페이지 rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/dalsung_dodong.png</기록물페이지>
                                        <유무형문화재_유무형문화재종류 rdf:resource="http://sight.eventpool.kr/resource/서원"/>
                                      </유무형문화유산>
                                    </숙박_유무형문화유산>
                                    <숙박_유물유적>
                                      <유물유적 rdf:about="http://sight.eventpool.kr/resource/광주_삼리_구석기유적">
                                        <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/구석기"/>
                                        <skos:altLabel rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >廣州 三里 舊石器遺蹟</skos:altLabel>
                                        <유물유적_숙박 rdf:resource="http://sight.eventpool.kr/resource/영월민박"/>
                                        <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/주거지유적"/>
                                        <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                        >경기도 광주시 곤지암읍</주소>
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >광주 삼리 구석기유적</rdfs:label>
                                        <dc:description rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >경기도 광주시 곤지암읍 삼리 곤지암 도자공원 일원에 위치한 구석기 유적은 경기도 광주 곤지암 지역에서 발견된 선사시대 유적 중 하나입니다. 이 지역은 곤지암 도자공원과 가까운 곳에 위치해 있으며, 구석기 시대의 다양한 유물들이 출토된 중요한 유적지로 알려져 있습니다.&#xD;
&#xD;
곤지암 지역은 특히 도자기와 관련된 문화재로 유명하지만, 삼리 지역에서 발견된 구석기 유적은 구석기 시대 초기 사람들의 주거지, 수렵과 채집 생활을 이해하는 데 중요한 자료를 제공합니다. 이곳에서 발굴된 석기 도구와 불쏘시개 등의 유물들은 구석기 시대 사람들의 생존 방식과 기술 수준을 연구하는 데 중요한 단서를 제공합니다.&#xD;
&#xD;
곤지암 도자공원 주변은 선사시대 유적과 도자기 문화가 결합된 독특한 지역으로, 구석기 시대부터 도자기 문화에 이르는 역사적 연속성을 탐구할 수 있는 장소로 평가받고 있습니다. 이 지역에서 출토된 유물들은 구석기 시대의 생활과 청동기 시대의 문화를 이어주는 중요한 연결 고리를 형성합니다.</dc:description>
                                        <참고 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                        > 2003년 4월 21일경기도의 기념물제188호로 지정</참고>
                                        <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/광주시"/>
                                      </유물유적>
                                    </숙박_유물유적>
                                    <숙박_자연물 rdf:resource="http://sight.eventpool.kr/resource/계룡산"/>
                                  </민박_게스트하우스>
                                </맛집_숙박>
                                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >설성식당</rdfs:label>
                                <맛집_특정장소 rdf:resource="http://sight.eventpool.kr/resource/다산초당"/>
                              </한식>
                            </특정장소_맛집>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >다산초당</rdfs:label>
                            <특정장소_시군구 rdf:resource="http://sight.eventpool.kr/resource/강진군"/>
                          </특정장소>
                        </지역_특정장소>
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gangjin.png</기록물페이지>
                        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >강진군</rdfs:label>
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gangjin_park3.png</기록물페이지>
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gangjin_park2.png</기록물페이지>
                        <지역_특정장소>
                          <특정장소 rdf:about="http://sight.eventpool.kr/resource/김영랑생가">
                            <특정장소_지역 rdf:resource="http://sight.eventpool.kr/resource/강진군"/>
                            <특정장소_시군구 rdf:resource="http://sight.eventpool.kr/resource/강진군"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >김영랑생가</rdfs:label>
                            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >34.6416965115684, 126.76593348291729</geo:lat_long>
                          </특정장소>
                        </지역_특정장소>
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gangjin3.png</기록물페이지>
                        <지역_자연물>
                          <자연물 rdf:about="http://sight.eventpool.kr/resource/만덕산">
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >만덕산</rdfs:label>
                            <자연물_지역 rdf:resource="http://sight.eventpool.kr/resource/강진군"/>
                          </자연물>
                        </지역_자연물>
                        <지역_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/강진만_춤추는_갈대_축제"/>
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gangjin4.png</기록물페이지>
                        <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >강진군은 전라남도에 위치한 아름다운 자연과 풍부한 문화유산을 지닌 관광지로, 역사적 유적과 자연 경관을 동시에 즐길 수 있는 매력적인 여행지입니다. 강진만의 강진만 생태공원은 멸종위기 생물과 철새들이 찾는 갯벌 생태의 보고로, 탐방로와 전망대를 통해 생태를 감상할 수 있는 특별한 체험을 제공합니다.&#xD;
&#xD;
또한, 조선시대 다산 정약용이 유배 생활을 하며 학문을 연마한 다산초당이 위치해 있어 학문과 사색의 장소로 많은 방문객을 끌고 있습니다. 강진군의 백운동정원은 아름답고 전통적인 정원으로, 정갈하게 꾸며진 자연 경관을 감상하며 고즈넉한 시간을 보낼 수 있습니다.&#xD;
&#xD;
강진은 또한 청자 박물관과 다양한 문화재, 역사적 유적지와 함께 계절마다 새로운 풍경을 선사하는 장소들로 가득 차 있어, 남도의 전통 문화와 자연을 동시에 느낄 수 있는 최고의 여행지입니다.</dc:description>
                        <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gangjin1.png</그림>
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gangjin_park4.png</기록물페이지>
                        <지역_관광명소>
                          <관광명소 rdf:about="http://sight.eventpool.kr/resource/무위사">
                            <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/사찰"/>
                            <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/moowi.png</그림>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >아무 것도 안하는 집&#xD;
&#xD;
무위사는 전라남도 월출산에 위치한 고즈넉한 사찰로, 자연의 아름다움과 깊은 역사를 간직한 장소입니다. 이 사찰은 6세기 경에 창건된 것으로 전해지며, 월출산의 웅장한 경관을 배경으로 하여 신성한 분위기를 자아냅니다.&#xD;
&#xD;
무위사는 특히 조용하고 평화로운 환경 속에서 마음을 다스리기 좋은 곳으로, 사찰 내부에는 다양한 불상과 문화재가 소중히 보존되어 있습니다. 이곳의 대표적인 명소인 무위사 대웅전은 아름다운 전통 건축물로, 많은 방문객들이 찾는 기도처이자 문화재로서의 가치를 지니고 있습니다</dc:description>
                            <관광명소_자연물>
                              <자연물 rdf:about="http://sight.eventpool.kr/resource/월출산">
                                <자연물_여행인프라>
                                  <축제_전시 rdf:about="http://sight.eventpool.kr/resource/월출산_국화축제">
                                    <geo:lat_long rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >34.76600331325023, 126.62679622558636</geo:lat_long>
                                    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/youngam2.png</그림>
                                    <여행인프라_자연물 rdf:resource="http://sight.eventpool.kr/resource/월출산"/>
                                    <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/지역축제"/>
                                    <dc:description rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >전라남도 영암군 영암읍에 위치한 기찬랜드에서 열리는 월출산 국화축제는 매년 가을, 국화의 향기로 가득 찬 멋진 풍경을 선사합니다. 이번 축제의 주제는 “국화의 빛으로 가을을 밝혀라”이며, 약 1억 송이 국화가 전시되어 다채로운 색감과 향기를 제공합니다.&#xD;
&#xD;
낮에는 국화가 만발한 전시 공간을 감상할 수 있으며, 저녁에는 조명과 오로라로 빛나는 특별한 야경 프로그램인 월출 산책 ‘야경로드’가 진행되어 이색적인 야경을 경험할 수 있습니다. 축제 기간 동안 국화콘서트, 거리 공연, 꽃밭 체험, 영암 예술인 공방 등 다양한 프로그램이 마련되어 방문객에게 즐거운 시간을 선사합니다.</dc:description>
                                    <rdfs:label rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >월출산 국화축제</rdfs:label>
                                    <여행인프라_지역 rdf:resource="http://sight.eventpool.kr/resource/영암군"/>
                                  </축제_전시>
                                </자연물_여행인프라>
                                <자연물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/무위사"/>
                                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >월출산</rdfs:label>
                                <자연물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/도갑사"/>
                                <자연물_지역 rdf:resource="http://sight.eventpool.kr/resource/영암군"/>
                              </자연물>
                            </관광명소_자연물>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >무위사</rdfs:label>
                            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >34.738641, 126.686928</geo:lat_long>
                            <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/강진군"/>
                          </관광명소>
                        </지역_관광명소>
                      </전라남도>
                    </여행인프라_지역>
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >강진만 춤추는 갈대 축제</rdfs:label>
                    <여행인프라_관광명소 rdf:resource="http://sight.eventpool.kr/resource/강진만_생태공원"/>
                    <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >34.62036664305246, 126.77393719489511</geo:lat_long>
                    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >강진만 춤추는 갈대 축제는 전라남도 강진군 강진읍에 위치한 강진만 생태공원에서 열리는 가을 축제로, 황금빛 갈대와 아름다운 노을을 배경으로 한 힐링 명소입니다. 이곳에서 펼쳐지는 잔잔한 갈대 물결은 방문객에게 깊은 정취와 여유를 선사합니다.&#xD;
&#xD;
축제 기간 동안 다양한 공연과 먹거리가 제공되며, 음악과 함께 강진만의 석양을 감상할 수 있어 감동적인 가을의 낭만을 즐길 수 있습니다. 강진만 생태공원은 1,131종의 다양한 생물이 서식하는 자연의 보고로, 생태 체험과 자연을 만끽할 수 있는 최고의 장소입니다.</dc:description>
                  </축제_전시>
                </인프라종류_여행인프라>
                <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/월출산_국화축제"/>
                <인프라종류_여행인프라>
                  <축제_전시 rdf:about="http://sight.eventpool.kr/resource/부평풍물대축제">
                    <여행인프라_지역>
                      <인천광역시 rdf:about="http://sight.eventpool.kr/resource/부평구">
                        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >부평구</rdfs:label>
                        <지역_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/부평풍물대축제"/>
                      </인천광역시>
                    </여행인프라_지역>
                    <여행인프라_문화예술>
                      <문화예술 rdf:about="http://sight.eventpool.kr/resource/사물놀이">
                        <문화예술_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/부평풍물대축제"/>
                        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >사물놀이</rdfs:label>
                      </문화예술>
                    </여행인프라_문화예술>
                    <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/지역축제"/>
                    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >부평 지역의 자랑인 ‘풍물’을 주제로 열리는 부평풍물대축제는 도심 속 8차선 대로를 배경으로 시민이 만들어가는 풍물난장, 시민축제, 거리공연, 다채로운 체험행사 등을 즐길 수 있다.&#xD;
&#xD;
또한 김덕수 사물놀이, 밴드 이상, 락밴드 노브레인, 소리꾼 김준수, 해외초청공연단(브라질 삼바, 대만 사자춤) 등이 출연해 개막식을 장식한다고 하니 개막공연을 놓치지 말자.&#xD;
&#xD;
더불어 아이들이 좋아하는 슬라임 놀이터, 그립톡&amp;컬러비즈, 캐리커쳐부터 어른들이 선호하는 막걸리 빚기 체험, 세계 여러 나라 전통의상 입어보기(포토존), 전통악기, 볏짚공예 등의 프로그램이 마련돼 다양한 이색체험을 만끽할 수 있다.&#xD;
&#xD;
부평풍물대축제는 무료로 즐길 수 있으며 이곳과 관련해 032-509-7516~7517로 문의할 수 있다.</dc:description>
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >부평풍물대축제</rdfs:label>
                  </축제_전시>
                </인프라종류_여행인프라>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >지역축제</rdfs:label>
                <인프라종류_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/자라섬_재즈_페스티벌"/>
                <인프라종류_여행인프라>
                  <축제_전시 rdf:about="http://sight.eventpool.kr/resource/함평_국향대전">
                    <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >35.05621774046375, 126.52000203485002</geo:lat_long>
                    <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/hampyung2.png</기록물페이지>
                    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >https://linkeddata.s3.us-east-1.amazonaws.com/hampyung.png</그림>
                    <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/지역축제"/>
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >함평 국향대전</rdfs:label>
                    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >함평 국향대전은 대한민국을 대표하는 국화축제로, 올해는 **'함평국화의 겨울이야기'**라는 주제로 열립니다. 2004년부터 함평 지역의 관광을 촉진하기 위해 시작된 이 축제는 가을철 국화로 다양한 예술 작품을 만들어 전시하는 행사로 유명합니다.&#xD;
&#xD;
국향대전에서는 가을과 겨울의 정취를 담은 다채로운 경관을 감상할 수 있습니다. 대형 트리, 종소리 게이트, 마법의 성과 9층 탑 등으로 꾸며진 대형 국화 작품은 물론, 매년 새로운 국화 분재 작품들이 추가되어 방문객들에게 색다른 볼거리를 선사합니다.</dc:description>
                    <여행인프라_지역>
                      <전라남도 rdf:about="http://sight.eventpool.kr/resource/함평군">
                        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >함평군</rdfs:label>
                        <지역_여행인프라 rdf:resource="http://sight.eventpool.kr/resource/함평_국향대전"/>
                      </전라남도>
                    </여행인프라_지역>
                  </축제_전시>
                </인프라종류_여행인프라>
                <인프라종류_여행인프라>
                  <축제_전시 rdf:about="http://sight.eventpool.kr/resource/온달문화축제">
                    <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >37.06370841967662, 128.49098949683022</geo:lat_long>
                    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/ondal.png</그림>
                    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >온달문화축제</rdfs:label>
                    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                    >온달문화축제는 매년 10월 초에 개최되는 지역 축제로, 전국 최초의 고구려 축제입니다. 이 축제는 고구려 전통문화를 체험하고 즐길 수 있도록 다양한 프로그램과 테마존이 마련되어 있습니다.&#xD;
&#xD;
특히 메인 프로그램으로는 황궁 개막식, 퍼레이드, 드론 라이트쇼, 국악 공연, 삼회향놀이, 온달과 평강공주 연극, 고구려 무예 시범, 도립교향악단 오케스트라 등 다채로운 행사들이 포함되어 있어 관람객들에게 큰 재미와 감동을 선사합니다. 온달문화축제는 지역 문화의 가치를 높이고, 고구려의 전통을 널리 알리는 중요한 행사로 자리잡고 있습니다.</dc:description>
                    <여행인프라_인프라종류 rdf:resource="http://sight.eventpool.kr/resource/지역축제"/>
                    <여행인프라_지역>
                      <충청북도 rdf:about="http://sight.eventpool.kr/resource/단양군">
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.amazonaws.com/travel/dodam.png</기록물페이지>
                        <지역_관광명소>
                          <관광명소 rdf:about="http://sight.eventpool.kr/resource/사인암">
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >사인암</rdfs:label>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >사인암은 충북 단양군 대강면에 위치한 단양 8경 중 하나로, 높이 70m의 거대한 기암절벽이 인상적인 명소입니다. 이곳은 남조천변을 따라 흐르는 단풍이 암벽과 어우러져 그림 같은 장관을 이룹니다.&#xD;
&#xD;
주요 특징&#xD;
&#xD;
기암절벽" 사인암의 기암절벽은 백악기 흑운모 화강암으로 형성되었으며, 수직의 암벽은 마치 수백 년 된 고풍스러운 탑을 연상케 합니다. 이 거대한 암벽은 자연의 위대함을 느낄 수 있는 장소입니다.&#xD;
&#xD;
단풍과 자연경관: 가을철에 방문하면 단풍과 암벽이 어우러져 더욱 아름다운 풍경을 선사합니다. 남조천변을 따라 흐르는 단풍은 사인암과 함께 독특하고 평화로운 경관을 만들어냅니다.&#xD;
&#xD;
지질학적 가치: 사인암은 독특한 지질과 침식지형으로 유명하며, 이 지역에서 한국의 지질학적 가치를 확인할 수 있는 중요한 장소입니다. 자연과 지질을 동시에 감상할 수 있는 특별한 경험을 제공합니다.&#xD;
&#xD;
사인암은 단양의 자연미와 지질학적 가치를 한꺼번에 경험할 수 있는 명소로, 특히 가을에 방문하면 그 아름다움을 한층 더 느낄 수 있습니다.</dc:description>
                            <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/sainam.png</그림>
                            <참고 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >인암의 기암절벽은 백악기 흑운모 화강암으로 형성</참고>
                            <geo:lat_long rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >36.894551, 128.340416</geo:lat_long>
                            <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/기암괴석"/>
                            <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/단양군"/>
                          </관광명소>
                        </지역_관광명소>
                        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/danyang_jando2.png</기록물페이지>
                        <지역_유물유적>
                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/단양_구낭굴_유적">
                            <주소 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >충청북도 단양군 가곡면</주소>
                            <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >단양 구낭굴 유적(丹陽 구낭굴 遺蹟)은?충청북도?단양군?가곡면?여천리에 있는?구석기시대의 동굴유적이다. 1994년 12월 30일?충청북도의 기념물?제103호로 지정되었다.</dc:description>
                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/거석기념물"/>
                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/구석기"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >단양 구낭굴 유적</rdfs:label>
                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/단양군"/>
                          </유물유적>
                        </지역_유물유적>
                        <지역_관광명소>
                          <관광명소 rdf:about="http://sight.eventpool.kr/resource/온달동굴">
                            <관광명소_관광명소종류>
                              <관광명소종류 rdf:about="http://sight.eventpool.kr/resource/동굴">
                                <관광명소종류_관광명소>
                                  <관광명소 rdf:about="http://sight.eventpool.kr/resource/광명동굴">
                                    <rdfs:label rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >광명동굴</rdfs:label>
                                    <dc:description rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >광명동굴은 경기도 광명시 가학동에 위치한 유서 깊은 동굴로, 과거 일제강점기였던 1912년부터 1972년까지 금, 은, 아연 등을 채굴하던 광산이었습니다. 이후 40여 년간 폐광 상태로 방치되었으나, 2011년부터 광명시가 복원 및 관광지로 재개발하여 2015년부터 일반에 공개되었습니다.&#xD;
&#xD;
현재 광명동굴은 복합문화공간으로 재탄생하여, 빛의 미디어아트 전시관, 와인 저장고, 아쿠아월드, VR 체험관 등 다양한 볼거리와 체험 시설을 갖추고 있습니다. 특히 와인동굴에서는 전국 각지에서 생산된 다양한 와인을 시음하고 구매할 수 있으며, 동굴 내 온도가 연중 일정하게 유지되어 쾌적한 관람이 가능합니다.&#xD;
&#xD;
광명동굴은 대한민국의 산업 유산을 보존하면서도 현대적 감각을 더해 관광객들에게 특별한 경험을 제공하는 명소로, 연간 많은 방문객이 찾고 있습니다.</dc:description>
                                    <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gwang4.png</기록물페이지>
                                    <그림 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >https://linkeddata.s3.us-east-1.amazonaws.com/travel/gwang.png</그림>
                                    <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/동굴"/>
                                    <geo:lat_long rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >37.445580, 126.864669</geo:lat_long>
                                    <관광명소_지역>
                                      <경기도 rdf:about="http://sight.eventpool.kr/resource/광명시">
                                        <지역_관광명소 rdf:resource="http://sight.eventpool.kr/resource/광명동굴"/>
                                        <지역_관광명소>
                                          <관광명소 rdf:about="http://sight.eventpool.kr/resource/안터생태공원">
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >안터생태공원</rdfs:label>
                                            <주소 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >대한민국 경기도 광명시 하안1동 327-6</주소>
                                            <그림 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/antu.png</그림>
                                            <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/생태공원"/>
                                            <geo:lat_long rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >37.458965, 126.869778</geo:lat_long>
                                            <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/광명시"/>
                                            <dc:description rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >안터생태공원은 경기도 광명시 안재로1번길 27에 위치한 도심 속 내륙습지로, 약 20,000㎡의 넓은 부지에 다양한 생물들이 서식하는 자연 친화적인 공원입니다. 이 공원은 멸종위기 야생생물 2급인 금개구리를 포함한 다양한 양서류, 파충류, 어류, 조류 등 다양한 생물들이 서식하고 있어 생태계의 중요한 보전지역으로 인정받고 있습니다.&#xD;
&#xD;
공원 내에는 자생초 화원과 실개울이 조성되어 있어 방문객들이 산책을 즐기며 다양한 식물과 동물을 가까이에서 관찰할 수 있는 기회를 제공합니다. 이곳은 생태적 가치를 갖춘 공간으로, 자연과의 소통을 원하는 시민들에게 큰 인기를 끌고 있습니다.</dc:description>
                                            <관광명소_주변동식물>
                                              <주변동식물 rdf:about="http://sight.eventpool.kr/resource/금개구리">
                                                <rdfs:label rdf:datatype=
                                                "http://www.w3.org/2001/XMLSchema#string"
                                                >금개구리</rdfs:label>
                                                <주변동식물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/안터생태공원"/>
                                              </주변동식물>
                                            </관광명소_주변동식물>
                                            <기록물페이지 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/antu2.png</기록물페이지>
                                          </관광명소>
                                        </지역_관광명소>
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >광명시</rdfs:label>
                                        <지역_관광명소>
                                          <관광명소 rdf:about="http://sight.eventpool.kr/resource/도덕산_출렁다리">
                                            <기록물페이지 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/doduksan2.png</기록물페이지>
                                            <그림 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/doduksan.png</그림>
                                            <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/출렁다리"/>
                                            <dc:description rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >도덕산 출렁다리는 경기도 광명시 광명동 317-80에 위치한 도덕산 도시자연공원 내에 있는 Y자형 출렁다리입니다. 이 다리는 높이 20m, 길이 82m, 폭 1.5m로, 인공폭포의 상부와 등산로 두 지점을 연결하여 산책로를 한층 다채롭게 만들어줍니다.&#xD;
&#xD;
출렁다리 중앙에서는 인공폭포를 배경으로 탁 트인 풍경과 추억을 남길 수 있는 포토 스팟을 제공하며, 광명시 도심에서 자연을 만끽할 수 있는 특별한 체험을 선사합니다. 또한, 사계절에 따라 변하는 아름다운 경관 덕분에 가족 단위 방문객들 사이에서도 인기가 높습니다.</dc:description>
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >도덕산 출렁다리</rdfs:label>
                                            <주소 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >대한민국 경기도 광명시 광명7동</주소>
                                            <geo:lat_long rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >37.468213, 126.859606</geo:lat_long>
                                            <관광명소_지역 rdf:resource="http://sight.eventpool.kr/resource/광명시"/>
                                          </관광명소>
                                        </지역_관광명소>
                                        <지역_유물유적>
                                          <유물유적 rdf:about="http://sight.eventpool.kr/resource/광명_철산동_지석묘">
                                            <주소 rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >경기도 광명시 철산3동</주소>
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >광명 철산동 지석묘</rdfs:label>
                                            <유물유적_종류 rdf:resource="http://sight.eventpool.kr/resource/거석기념물"/>
                                            <유물유적_시대 rdf:resource="http://sight.eventpool.kr/resource/청동기"/>
                                            <dc:description rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >광명 철산동 지석묘는 대한민국 경기도 광명시 철산동에 위치한 청동기 시대의 고인돌(지석묘) 유적입니다. 이 지석묘는 고인돌의 한 형태로, 주로 청동기 시대의 장례 문화와 관련이 있으며, 묘지의 일종으로 고대 사람들이 사용했던 거석 구조물입니다.&#xD;
&#xD;
철산동 지석묘는 대형의 덮개돌(상석)과 이를 받치는 기둥돌(지석)로 구성되어 있으며, 이 지역에서 발견된 고인돌들은 당시 사람들이 사후 세계나 조상 숭배와 관련된 신앙과 의식을 가졌음을 보여줍니다. 또한, 이러한 지석묘는 청동기 시대의 사회적 계층이나 구조를 연구하는 데 중요한 자료를 제공합니다.&#xD;
&#xD;
철산동 지석묘는 경기도 내의 대표적인 청동기 유적 중 하나로, 고대 한국인의 장례 의식과 사회적 구조를 이해하는 데 중요한 역할을 합니다. 또한, 이 지석묘는 국가지정문화재로 보호되며, 광명 지역의 선사 시대 연구에 중요한 자료로 평가되고 있습니다.</dc:description>
                                            <유물유적_지역 rdf:resource="http://sight.eventpool.kr/resource/광명시"/>
                                          </유물유적>
                                        </지역_유물유적>
                                      </경기도>
                                    </관광명소_지역>
