                                                >35.474449, 126.633116</geo:lat_long>
                                                <관광명소_주변동식물>
                                                  <주변동식물 rdf:about="http://sight.eventpool.kr/resource/삵">
                                                    <주변동식물_관광명소 rdf:resource="http://sight.eventpool.kr/resource/운곡람사르습지"/>
