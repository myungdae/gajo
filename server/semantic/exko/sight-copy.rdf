        <기록물페이지 rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >https://linkeddata.s3.us-east-1.amazonaws.com/travel/chungsong_joowang1.png</기록물페이지>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >주왕산 국립공원</rdfs:label>
        <관광명소_관광명소종류 rdf:resource="http://sight.eventpool.kr/resource/국립공원"/>
      </관광명소>
    </관광명소종류_관광명소>
    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/북한산_국립공원"/>
    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/한라산_국립공원"/>
    <관광명소종류_관광명소 rdf:resource="http://sight.eventpool.kr/resource/월악산_국립공원"/>
                                                              </관광명소종류>
                                                            </관광명소_관광명소종류>
                                                            <관광명소_테마여행 rdf:resource="http://sight.eventpool.kr/resource/국립공원탐방"/>
                                                            <dc:description
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >북한산국립공원은 서울 도심에 위치하여 접근성이 뛰어나, 바쁜 일상 속에서도 쉽게 가을 단풍을 즐길 수 있는 명소입니다. 국립공원 내에는 다양한 난이도의 탐방로가 있으며, 그중 우이암 코스는 부담 없이 오를 수 있어 가을철 트레킹을 즐기기에 좋습니다.&#xD;
&#xD;
또한, 북한산 둘레길은 총 21개의 코스로 이루어져 있어 남녀노소 누구나 편하게 걸을 수 있는 산책로를 제공합니다. 가을의 정취를 빠르게 만날 수 있는 이곳은 서울의 가을 트레킹 명소로 인기를 끌며 많은 이들이 자연과 함께 여유로운 시간을 보내는 장소로 추천됩니다.&#xD;
&#xD;
▶우이암 코스 : 도봉탐방지원센터-천진사-우이암 [난이도 하, 총 3km]&#xD;
▶북한산성 코스 &amp; 북한산 둘레길 8코스 추천</dc:description>              <그림
                                                             rdf:datatype=
                                                            "http://www.w3.org/2001/XMLSchema#string"
                                                            >https://linkeddata.s3.us-east-1.amazonaws.com/travel/mtbukhan.png</그림>
