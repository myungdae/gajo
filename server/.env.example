PORT=3000
MONGODB_URI=mongodb://localhost:27017/gajo

# Kakao Developers > application > App keys > REST API key.
# Keep this server-side. Never expose it through a VITE_* variable.
KAKAO_REST_API_KEY=
KAKAO_LOCAL_TIMEOUT_MS=5000
CLOSING_SOON_MINUTES=60

GAJO_LATITUDE=35.7423
GAJO_LONGITUDE=127.9528
GAJO_TIMEZONE=Asia/Seoul
OPEN_METEO_TIMEOUT_MS=3500

# Optional server-side natural-language context extraction. When unset,
# Gajo safely uses the deterministic Korean parser only.
CONTEXT_EXTRACTOR_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CONTEXT_MODEL=
OPENAI_CONTEXT_TIMEOUT_MS=8000
MAX_CONTEXT_LLM_CALLS_PER_SESSION=3
# Optional admin-only cost estimate. Leave blank rather than assuming model pricing.
OPENAI_CONTEXT_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_CONTEXT_OUTPUT_USD_PER_MILLION_TOKENS=
